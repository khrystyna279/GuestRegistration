<Window x:Class="GuestRegistration.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Guest Registration" Width="1040" Height="820" MinWidth="800" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="Guest Registration" FontSize="26" FontWeight="SemiBold" Foreground="#172B4D"/>
    <TextBlock Text="{Binding SessionCaption}" Foreground="#61718B" Margin="0,4,0,0"/></StackPanel>
   <Button Content="Вийти з облікового запису" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
    Style="{StaticResource SecondaryButton}" Visibility="{Binding IsSignedIn, Converter={StaticResource VisibleWhenTrue}}"/>
  </Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,18">
   <Button Content="Вхід" Command="{Binding ShowLoginCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
   <Button Content="Реєстрація" Command="{Binding ShowRegistrationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
   <Button Content="Відновлення пароля" Command="{Binding ShowRecoveryCommand}" Style="{StaticResource SecondaryButton}"/>
  </StackPanel>
  <Border Grid.Row="2" Style="{StaticResource Card}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26">
    <ContentControl Content="{Binding Page}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
   </ScrollViewer>
  </Border>
 </Grid>
</Window>
