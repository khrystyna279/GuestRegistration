<UserControl x:Class="GuestRegistration.Wpf.Views.ProfileView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:infra="clr-namespace:GuestRegistration.Wpf.Infrastructure">
<StackPanel>
 <TextBlock Text="Мій профіль" Style="{StaticResource Heading}"/>
 <TextBlock Text="Вхід виконано. Тут відображаються лише ваші дані та картки." Style="{StaticResource Description}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Логін" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.Login}" Margin="0,0,0,16" TextWrapping="Wrap"/><TextBlock Text="Ім’я" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.FirstName}" Margin="0,0,0,16" TextWrapping="Wrap"/><TextBlock Text="Прізвище" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.LastName}" Margin="0,0,0,16" TextWrapping="Wrap"/><TextBlock Text="Стать" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.Gender}" Margin="0,0,0,16" TextWrapping="Wrap"/><TextBlock Text="E-mail" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.Email}" Margin="0,0,0,16" TextWrapping="Wrap"/><TextBlock Text="Телефон" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.Phone}" Margin="0,0,0,16" TextWrapping="Wrap"/><TextBlock Text="Адреса" Style="{StaticResource Label}"/><TextBlock Text="{Binding Profile.Address}" Margin="0,0,0,16" TextWrapping="Wrap"/></StackPanel>
 <StackPanel Grid.Column="2"><TextBlock Text="Картки" Style="{StaticResource Label}"/>
 <ItemsControl ItemsSource="{Binding Profile.Cards}"><ItemsControl.ItemTemplate><DataTemplate>
  <Border Style="{StaticResource Card}" Padding="16" Margin="0,6,0,10"><StackPanel>
   <TextBlock Text="{Binding Brand}" FontWeight="SemiBold"/>
   <TextBlock Margin="0,8,0,0"><Run Text="•••• "/><Run Text="{Binding LastFourDigits}"/></TextBlock>
   <TextBlock Text="{Binding Holder}" Margin="0,6,0,0"/>
   <TextBlock Margin="0,6,0,0"><Run Text="Діє до "/><Run Text="{Binding Month}"/><Run Text="/"/><Run Text="{Binding Year}"/></TextBlock>
  </StackPanel></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>
 <Button Content="Оновити дані" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
 <TextBlock Text="{Binding Message}" Style="{StaticResource Message}"/>
</StackPanel>
</UserControl>
