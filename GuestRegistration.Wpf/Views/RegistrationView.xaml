<UserControl x:Class="GuestRegistration.Wpf.Views.RegistrationView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:infra="clr-namespace:GuestRegistration.Wpf.Infrastructure">
<StackPanel>
 <TextBlock Text="Реєстрація" Style="{StaticResource Heading}"/>
 <TextBlock Text="Заповніть усі поля. Для навчальної картки можна використати 4111111111111111; повний номер у базі не зберігається." Style="{StaticResource Description}"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Логін" Style="{StaticResource Label}"/><TextBox MaxLength="30" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [Login]}" Style="{StaticResource FieldError}"/><TextBlock Text="Ім’я" Style="{StaticResource Label}"/><TextBox MaxLength="50" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [FirstName]}" Style="{StaticResource FieldError}"/><TextBlock Text="Прізвище" Style="{StaticResource Label}"/><TextBox MaxLength="50" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [LastName]}" Style="{StaticResource FieldError}"/><TextBlock Text="Пароль" Style="{StaticResource Label}"/><PasswordBox MaxLength="100" infra:PasswordBinding.Enabled="True" infra:PasswordBinding.Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [Password]}" Style="{StaticResource FieldError}"/><TextBlock Text="Підтвердження пароля" Style="{StaticResource Label}"/><PasswordBox MaxLength="100" infra:PasswordBinding.Enabled="True" infra:PasswordBinding.Value="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [ConfirmPassword]}" Style="{StaticResource FieldError}"/><TextBlock Text="Ключове слово для відновлення" Style="{StaticResource Label}"/><PasswordBox MaxLength="100" infra:PasswordBinding.Enabled="True" infra:PasswordBinding.Value="{Binding RecoveryWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [RecoveryWord]}" Style="{StaticResource FieldError}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Стать" Style="{StaticResource Label}"/>
 <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Gender, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
 <ComboBoxItem Content="Жіноча" Tag="Female"/><ComboBoxItem Content="Чоловіча" Tag="Male"/><ComboBoxItem Content="Інше" Tag="Other"/>
 </ComboBox><TextBlock Text="{Binding [Gender]}" Style="{StaticResource FieldError}"/><TextBlock Text="Адреса" Style="{StaticResource Label}"/><TextBox MaxLength="200" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [Address]}" Style="{StaticResource FieldError}"/><TextBlock Text="E-mail" Style="{StaticResource Label}"/><TextBox MaxLength="254" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [Email]}" Style="{StaticResource FieldError}"/><TextBlock Text="Телефон" Style="{StaticResource Label}"/><TextBox MaxLength="16" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [Phone]}" Style="{StaticResource FieldError}"/><TextBlock Text="Навчальний номер картки" Style="{StaticResource Label}"/><TextBox MaxLength="23" Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [CardNumber]}" Style="{StaticResource FieldError}"/><TextBlock Text="Власник картки латиницею" Style="{StaticResource Label}"/><TextBox MaxLength="100" Text="{Binding CardHolder, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [CardHolder]}" Style="{StaticResource FieldError}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Місяць дії" Style="{StaticResource Label}"/><TextBox MaxLength="2" Text="{Binding ExpirationMonth, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [ExpirationMonth]}" Style="{StaticResource FieldError}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Рік дії" Style="{StaticResource Label}"/><TextBox MaxLength="4" Text="{Binding ExpirationYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/><TextBlock Text="{Binding [ExpirationYear]}" Style="{StaticResource FieldError}"/></StackPanel></Grid></StackPanel></Grid>
 <Button Content="Зареєструватися" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}"/>
 <TextBlock Text="{Binding Message}" Style="{StaticResource Message}"/>
</StackPanel>
</UserControl>
