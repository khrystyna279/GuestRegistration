<Application x:Class="GuestRegistration.Wpf.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:GuestRegistration.Wpf.ViewModels"
 xmlns:views="clr-namespace:GuestRegistration.Wpf.Views"
 xmlns:infra="clr-namespace:GuestRegistration.Wpf.Infrastructure">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/Theme.xaml"/></ResourceDictionary.MergedDictionaries>
   <infra:InverseBooleanConverter x:Key="Not"/>
   <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
   <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
   <DataTemplate DataType="{x:Type vm:RegistrationViewModel}"><views:RegistrationView/></DataTemplate>
   <DataTemplate DataType="{x:Type vm:RecoveryViewModel}"><views:RecoveryView/></DataTemplate>
   <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><views:ProfileView/></DataTemplate>
   <DataTemplate DataType="{x:Type vm:RestrictedViewModel}"><views:RestrictedView/></DataTemplate>
  </ResourceDictionary>
 </Application.Resources>
</Application>
